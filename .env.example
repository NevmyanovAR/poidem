# Локальная конфигурация. Секретов здесь нет.
# scripts/Initialize-LocalEnvironment.ps1 создаёт игнорируемый .env
# со случайными локальными паролями и заполненными URL.
APP_ENV=development
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
BACKEND_PORT=8001
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_URL_TEST=
MIGRATION_DATABASE_URL_TEST=
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173","http://localhost:4173"]
TRUSTED_HOSTS=["127.0.0.1","localhost"]
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
LOG_LEVEL=INFO


# Telegram: настоящий токен вводится через Set-TelegramToken.ps1, не в Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ShallWeGoo_bot
# Необязательные уведомления; /notifications_off — персональный отказ в боте.
NOTIFICATIONS_ENABLED=true
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_LEASE_SECONDS=90
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
CHAT_NOTIFICATION_WINDOW_SECONDS=60
MINI_APP_URL=https://poidem-demo.pages.dev
# Внешний канонический адрес API появится после отдельной настройки HTTPS.
API_PUBLIC_URL=
INIT_DATA_MAX_AGE_SECONDS=300
AUTH_CLOCK_SKEW_SECONDS=30
SESSION_TTL_SECONDS=86400
# Пусто: Secure автоматически включён для APP_ENV=production.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=lax
MEDIA_ROOT=uploads/profiles
PHOTO_MAX_BYTES=3145728
PHOTO_MAX_PIXELS=16000000
PHOTO_MAX_EDGE=2048
LOGIN_REQUESTS_PER_MINUTE=30
PHOTO_REQUESTS_PER_MINUTE=10
# Технический антиспам встроенного текстового чата, на аккаунт за минуту.
CHAT_MESSAGES_PER_MINUTE=30

# Только публичные адреса. В production пустое значение отключает реальный API.
# /api/v1 на Pages требует отдельно настроенный прокси, его здесь нет.
VITE_API_BASE_URL=
VITE_TELEGRAM_BOT_USERNAME=ShallWeGoo_bot
POIDEM_API_PROXY_TARGET=http://127.0.0.1:8001
POIDEM_DEV_ALLOWED_HOSTS=[]

PLACES_SEARCH_PER_MINUTE=20
PLACES_RESOLVE_PER_MINUTE=10

# 11Б: не собирать реальные проверочные фото до утверждения текста/сроков
PHOTO_VERIFICATION_ENABLED=false
PHOTO_VERIFICATION_POLICY_APPROVED=false
PHOTO_VERIFICATION_CONSENT_VERSION=
PHOTO_VERIFICATION_CONSENT_TEXT=
PHOTO_VERIFICATION_PENDING_HOURS=
PHOTO_VERIFICATION_REVIEWED_RETENTION_HOURS=
# Технические ограничения, не санкции и не показатель надёжности
PHOTO_VERIFICATION_CHALLENGE_SECONDS=600
PHOTO_VERIFICATION_ATTEMPTS_PER_DAY=3

# D67: число разных партнёров для положительной отметки, не гарантия безопасности
POSITIVE_IMPRESSIONS_THRESHOLD=3
