# Preliminary configuration contract; no application reads this file yet.
# All values are intentionally empty. Do not put real secrets in this example.

# Server only: Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Server only: PostgreSQL connection URL.
# Driver and URL format will be selected during implementation.
DATABASE_URL=

# Public HTTPS address of the Mini App; used when configuring its launch.
MINI_APP_URL=

# Public API base URL for the future Vite frontend. Never store secrets here.
VITE_API_BASE_URL=
