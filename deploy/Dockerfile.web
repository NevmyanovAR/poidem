FROM node:22-bookworm-slim@sha256:be979e5523c76fa4d5ca4ebd3099078f220aa47ec39c48ad5b5df9314debd6eb AS build
WORKDIR /build/frontend
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html vite.config.ts tsconfig*.json ./
COPY src ./src
COPY public ./public
# Only public build arguments; .env, backend, tests and references never enter context.
ARG VITE_TELEGRAM_BOT_USERNAME=ShallWeGoo_bot
ENV VITE_API_BASE_URL=/api/v1 NODE_OPTIONS=--max-old-space-size=1024
RUN npm run build

FROM nginx:stable-alpine@sha256:8eb04fe3b385090e9aa02961f77398ad09b6bf33ab07f6669a5bb7acce22c0d3
COPY --from=build /build/frontend/dist /usr/share/nginx/html
COPY --from=nginx_config app.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_ENVSUBST_FILTER=^APP_DOMAIN$
EXPOSE 80 443
