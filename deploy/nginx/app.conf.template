# No request URLs, cookies or request bodies in web logs.
access_log off;
error_log /dev/null;
server_tokens off;
client_max_body_size 4m;
client_body_timeout 20s;
send_timeout 30s;

server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${APP_DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; try_files $uri =404; }
    location / { return 308 https://${APP_DOMAIN}$request_uri; }
}
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}
server {
    listen 443 ssl;
    server_name ${APP_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # No X-Frame-Options DENY/SAMEORIGIN: Mini App must work in Telegram Web.
    root /usr/share/nginx/html;
    index index.html;

    # Docker DNS is re-resolved when api is recreated during an update.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8001;
    location ^~ /api/ {
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
    }
    location = /health {
        proxy_pass $api_upstream/health;
        proxy_set_header Host $host;
        proxy_cache off;
        # FastAPI already sends Cache-Control: no-store.
    }
    location ~ /\. { return 404; }
    location ~ ^/(uploads|media|backend|references|deploy|docs)(/|$) { return 404; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        # expires adds max-age without overriding inherited security headers.
    }
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
