# Copy to deploy/production.env, chmod 600; never copy the local development .env.
# Generate all three passwords independently as 64 hexadecimal characters.
APP_DOMAIN=
COMPOSE_PROJECT_NAME=poidem-production
ACME_EMAIL=
RELEASE_TAG=
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ShallWeGoo_bot
# Same-origin deployment: preflight requires these to match APP_DOMAIN.
MINI_APP_URL=
API_PUBLIC_URL=
CORS_ORIGINS=[]
TRUSTED_HOSTS=[]
# None + Secure supports Telegram Web iframe; strict Origin/CSRF checks remain.
SESSION_COOKIE_SAMESITE=none
# Keep disabled until separate production approval of consent/retention/backups.
PHOTO_VERIFICATION_ENABLED=false
PHOTO_VERIFICATION_POLICY_APPROVED=false
PHOTO_VERIFICATION_CONSENT_VERSION=
PHOTO_VERIFICATION_CONSENT_TEXT=
PHOTO_VERIFICATION_PENDING_HOURS=
PHOTO_VERIFICATION_REVIEWED_RETENTION_HOURS=
PHOTO_VERIFICATION_CHALLENGE_SECONDS=600
PHOTO_VERIFICATION_ATTEMPTS_PER_DAY=3
POSITIVE_IMPRESSIONS_THRESHOLD=3
NOTIFICATIONS_ENABLED=true
# Optional exact image digests can replace these tags before release.
POSTGRES_IMAGE=postgres:17@sha256:b60e90042aa6b8dbecd58e224b3e36114dbf8ad754465264c2476ad58a86e45c
